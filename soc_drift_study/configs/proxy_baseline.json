{
  "rpt_candidate": {
    "qdischarge_min_ah": 1.0,
    "mean_current_min_ma": -1000,
    "mean_current_max_ma": -300,
    "duration_min_s": 3000,
    "voltage_min_max_v": 2.6,
    "sensitivity_duration_min_s": 1000
  },
  "flight_phase_filter": {
    "ns_values": [4, 5, 6],
    "mean_current_max_ma": -2000,
    "duration_min_s": 10
  },
  "soc_proxy": {
    "nominal_capacity_ah_before_first_rpt": 3.0,
    "capacity_anchor_rule": "latest completed candidate RPT with charge_cycle_index strictly less than the mission index",
    "formula": "clip(1 - QDischarge_Ah / prior_RPT_capacity_Ah, 0, 1)",
    "interpretation": "coulomb-counted proxy, not independent SOC ground truth"
  },
  "phase_ridge": {
    "n20_missions": 20,
    "alpha": 5.0,
    "features": [
      "phase_Ns",
      "duration_s",
      "I_mean_A",
      "I_peak_A",
      "Vmin_V",
      "Vmax_V",
      "Tmean_C",
      "Tmax_C"
    ],
    "prediction_clip": [0.0, 1.0],
    "split": "chronological per physical cell; first 20 mission indices train, later missions test"
  }
}
